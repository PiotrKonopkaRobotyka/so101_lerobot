<?xml version="1.0"?>
<!-- The SO-101 of lerobot_ws for Gazebo with our controller configuration (ADR 0004): the same as
     lerobot_description/urdf/so101.urdf.xacro, but gz_ros2_control loads our config/so101_controllers.yaml. -->
<robot name="so101" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find lerobot_description)/urdf/so101_base.xacro" />
    <xacro:include filename="$(find lerobot_description)/urdf/so101_ros2_control.xacro" />

    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find so101_bringup)/config/so101_controllers.yaml</parameters>
        </plugin>
    </gazebo>

</robot>
